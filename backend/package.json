{
  "name": "@maft/backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node --env-file=../.env dist/main.js",
    "db:push": "node --env-file=../.env ../node_modules/prisma/build/index.js db push",
    "db:seed": "node --env-file=../.env prisma/seed.mjs",
    "prisma": "npx prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "prisma": "^6.0.0",
    "typescript": "~5.9.0"
  }
}
