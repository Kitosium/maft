{
  "name": "maft",
  "private": true,
  "version": "1.0.0",
  "description": "Maft (Next.js + NestJS + Typescript)",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "check": "npm run check --workspace backend && npm run check --workspace frontend",
    "db:push": "npm run db:push --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
